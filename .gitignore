# This repo holds only the GitHub Pages website (docs/) and its deploy workflow.
# Everything else here (the iOS app, design files, screenshots, notes) stays on this Mac.
/*
!/.gitignore
!/.github/
!/docs/
!/tests/
!/README.md

# Local-only files inside the website folder
docs/config.js
docs/config.example.js
docs/icon.svg

# Test tooling installed during CI
node_modules/

# Never commit secrets or system files
.DS_Store
**/.DS_Store
.env
.env.*
*.p12
*.mobileprovision
